# ==============================================================================
# Apotek Alpro — Environment Variables
# Salin file ini ke .env.local dan isi dengan credential Supabase kamu
# ==============================================================================

# Prisma Database URL (Connection Pooling — untuk query runtime)
# Gunakan port 6543 (PgBouncer) dari Supabase Settings → Database → Connection Pooling
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"

# Prisma Direct URL (Direct Connection — untuk migration & introspection)
# Gunakan port 5432 (direct) dari Supabase Settings → Database → Direct Connection
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase Project URL (dari Settings → API → Project URL)
# Tanpa trailing slash
SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Supabase Anon Key (public, aman untuk client-side)
# Dari Settings → API → Project API keys → anon public
SUPABASE_ANON_KEY="eyJhbGciOiJI..."

# Supabase Service Role Key (SECRET — hanya untuk server-side!)
# Dari Settings → API → Project API keys → service_role
# JANGAN expose di client-side atau commit ke git
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJI..."

# Public keys (exposed ke browser — prefix NEXT_PUBLIC_)
# Isi dengan value yang sama dengan SUPABASE_URL dan SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJI..."
