// =============================================================================
// Apotek Alpro — Smart Prescription & Refill System
// Database Schema (Prisma ORM + PostgreSQL via Supabase)
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

/// Role user dalam sistem apotek
enum UserRole {
  PATIENT
  PHARMACIST
  ADMIN
}

/// Kategori obat: OTC bisa dibeli bebas, PRESCRIPTION butuh resep valid
enum MedicineCategory {
  OTC
  PRESCRIPTION
}

/// Status alur verifikasi resep oleh apoteker
enum PrescriptionStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Status alur pesanan dari pembuatan hingga pengiriman
enum OrderStatus {
  PENDING
  CONFIRMED
  READY
  DELIVERED
  CANCELLED
}

/// Tingkat keparahan interaksi antar obat
enum InteractionSeverity {
  MILD
  MODERATE
  SEVERE
}

// =============================================================================
// MODELS
// =============================================================================

/// User profile — extended dari Supabase Auth.
/// ID sinkron dengan auth.users.id di Supabase untuk RLS compatibility.
model User {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique
  name        String
  role        UserRole  @default(PATIENT)
  phone       String?
  address     String?
  pharmacyId  String?   @map("pharmacy_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relasi
  pharmacy              Pharmacy?          @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  prescriptions         Prescription[]     @relation("PatientPrescriptions")
  verifiedPrescriptions Prescription[]     @relation("PharmacistVerifications")
  orders                Order[]
  refillSchedules       RefillSchedule[]

  @@index([email])
  @@index([role])
  @@index([pharmacyId], map: "idx_user_pharmacy")
  @@map("users")
}

/// Cabang apotek Alpro — menyimpan lokasi dan status operasional.
/// Latitude/longitude untuk fitur "nearby pharmacy" dan stock check.
model Pharmacy {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  address   String
  city      String
  latitude  Float
  longitude Float
  phone     String?
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relasi
  staff     User[]
  inventory Inventory[]
  orders    Order[]

  @@index([city])
  @@index([isActive], map: "idx_pharmacy_active")
  @@map("pharmacies")
}

/// Master data obat — termasuk info regulasi (OTC vs prescription).
/// Field requiresPrescription menentukan apakah checkout butuh resep valid.
model Medicine {
  id                   String           @id @default(uuid()) @db.Uuid
  name                 String
  category             MedicineCategory
  activeIngredients    String           @map("active_ingredients")
  dosageForm           String           @map("dosage_form")
  manufacturer         String
  requiresPrescription Boolean          @default(false) @map("requires_prescription")
  price                Decimal          @db.Decimal(12, 2)
  description          String?
  deletedAt            DateTime?        @map("deleted_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  // Relasi
  inventory         Inventory[]
  prescriptionItems PrescriptionItem[]
  orderItems        OrderItem[]
  refillSchedules   RefillSchedule[]

  // Drug interaction — obat bisa muncul di sisi A atau B
  interactionsAsA DrugInteraction[] @relation("MedicineA")
  interactionsAsB DrugInteraction[] @relation("MedicineB")

  @@index([category])
  @@index([name])
  @@index([requiresPrescription], map: "idx_medicine_rx")
  @@map("medicines")
}

/// Stok obat per cabang — tabel utama untuk realtime stock check.
/// Field lastUpdated di-trigger update untuk Supabase Realtime subscription.
model Inventory {
  id          String   @id @default(uuid()) @db.Uuid
  pharmacyId  String   @map("pharmacy_id") @db.Uuid
  medicineId  String   @map("medicine_id") @db.Uuid
  quantity    Int      @default(0)
  minStock    Int      @default(10) @map("min_stock")
  lastUpdated DateTime @default(now()) @updatedAt @map("last_updated")

  // Relasi
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@unique([pharmacyId, medicineId], map: "uq_pharmacy_medicine")
  @@index([pharmacyId], map: "idx_inventory_pharmacy")
  @@index([medicineId], map: "idx_inventory_medicine")
  @@index([lastUpdated], map: "idx_inventory_updated")
  @@map("inventory")
}

/// Resep yang di-upload pasien — butuh verifikasi apoteker sebelum checkout.
/// imageUrl mengarah ke Supabase Storage bucket.
model Prescription {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  imageUrl       String?            @map("image_url")
  status         PrescriptionStatus @default(PENDING)
  verifiedById   String?            @map("verified_by_pharmacist_id") @db.Uuid
  notes          String?
  expiresAt      DateTime?          @map("expires_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  // Relasi
  patient      User               @relation("PatientPrescriptions", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy   User?              @relation("PharmacistVerifications", fields: [verifiedById], references: [id], onDelete: SetNull)
  items        PrescriptionItem[]
  orders       Order[]

  @@index([userId], map: "idx_prescription_user")
  @@index([status], map: "idx_prescription_status")
  @@index([verifiedById], map: "idx_prescription_verifier")
  @@map("prescriptions")
}

/// Item individual dalam satu resep — detail obat, jumlah, dan dosis.
model PrescriptionItem {
  id               String @id @default(uuid()) @db.Uuid
  prescriptionId   String @map("prescription_id") @db.Uuid
  medicineId       String @map("medicine_id") @db.Uuid
  quantity         Int
  dosageInstruction String @map("dosage_instruction")

  // Relasi
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([prescriptionId], map: "idx_rx_item_prescription")
  @@index([medicineId], map: "idx_rx_item_medicine")
  @@map("prescription_items")
}

/// Pesanan — menghubungkan pasien, cabang, dan (opsional) resep.
/// prescriptionId wajib jika ada item obat PRESCRIPTION di dalamnya.
model Order {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  pharmacyId      String      @map("pharmacy_id") @db.Uuid
  prescriptionId  String?     @map("prescription_id") @db.Uuid
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @db.Decimal(12, 2)
  deliveryAddress String?     @map("delivery_address")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relasi
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy     Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  items        OrderItem[]

  @@index([userId], map: "idx_order_user")
  @@index([pharmacyId], map: "idx_order_pharmacy")
  @@index([status], map: "idx_order_status")
  @@index([createdAt], map: "idx_order_created")
  @@map("orders")
}

/// Item individual dalam pesanan — snapshot harga saat pembelian.
/// priceAtPurchase disimpan terpisah dari Medicine.price untuk audit trail.
model OrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  medicineId      String  @map("medicine_id") @db.Uuid
  quantity        Int
  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(12, 2)

  // Relasi
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "idx_order_item_order")
  @@index([medicineId], map: "idx_order_item_medicine")
  @@map("order_items")
}

/// Jadwal refill otomatis untuk pasien dengan obat kronis.
/// Sistem akan generate reminder berdasarkan nextRefillDate.
model RefillSchedule {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  medicineId     String    @map("medicine_id") @db.Uuid
  frequencyDays  Int       @map("frequency_days")
  nextRefillDate DateTime  @map("next_refill_date")
  lastRefillDate DateTime? @map("last_refill_date")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relasi
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@unique([userId, medicineId], map: "uq_user_medicine_refill")
  @@index([userId], map: "idx_refill_user")
  @@index([nextRefillDate], map: "idx_refill_next_date")
  @@index([isActive], map: "idx_refill_active")
  @@map("refill_schedules")
}

/// Database interaksi antar obat untuk drug interaction checker.
/// Severity menentukan level warning saat checkout multi-obat.
model DrugInteraction {
  id           String              @id @default(uuid()) @db.Uuid
  medicineAId  String              @map("medicine_a_id") @db.Uuid
  medicineBId  String              @map("medicine_b_id") @db.Uuid
  severity     InteractionSeverity
  description  String
  createdAt    DateTime            @default(now()) @map("created_at")

  // Relasi
  medicineA Medicine @relation("MedicineA", fields: [medicineAId], references: [id], onDelete: Cascade)
  medicineB Medicine @relation("MedicineB", fields: [medicineBId], references: [id], onDelete: Cascade)

  @@unique([medicineAId, medicineBId], map: "uq_drug_interaction_pair")
  @@index([medicineAId], map: "idx_interaction_medicine_a")
  @@index([medicineBId], map: "idx_interaction_medicine_b")
  @@index([severity], map: "idx_interaction_severity")
  @@map("drug_interactions")
}
